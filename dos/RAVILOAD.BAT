@ECHO OFF
C:
CD \RAVI
IF "%1"=="" GOTO DEFAULTARGS
SET RAVIARGS=%1 %2 %3 %4 %5 %6 %7 %8 %9
GOTO CHECKBOOT
:DEFAULTARGS
SET RAVIARGS=/com1 /baud:38400 /root:C:\RAVI
:CHECKBOOT
REM Unconfirmed update from an earlier boot: restore the known-good agent.
IF EXIST UPDATE.PND GOTO ROLLBACK
:START
DOSRAVI %RAVIARGS%
IF ERRORLEVEL 86 GOTO END
IF ERRORLEVEL 85 GOTO NEWAGENT
GOTO END
:NEWAGENT
REM UPDATE status 85 reaches this label without passing the boot-time check.
DOSRAVI %RAVIARGS%
IF ERRORLEVEL 86 GOTO END
IF ERRORLEVEL 85 GOTO START
IF EXIST UPDATE.PND GOTO ROLLBACK
GOTO END
:ROLLBACK
REM A marker written before the first rename may have no .OLD yet.
IF NOT EXIST DOSRAVI.OLD GOTO CLEARMARK
IF EXIST DOSRAVI.BAD DEL DOSRAVI.BAD
IF EXIST DOSRAVI.COM REN DOSRAVI.COM DOSRAVI.BAD
REN DOSRAVI.OLD DOSRAVI.COM
:CLEARMARK
IF EXIST UPDATE.PND DEL UPDATE.PND
GOTO START
:END
SET RAVIARGS=
